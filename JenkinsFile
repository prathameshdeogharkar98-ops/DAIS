pipeline {
    agent any

    environment {
        DOTNET_CLI_TELEMETRY_OPTOUT = '1'
        DOTNET_NOLOGO = 'true'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify .NET') {
            steps {
                bat 'dotnet --info'
            }
        }

        stage('Restore') {
            steps {
                bat 'dotnet restore DIAS.slnx'
            }
        }

        stage('Build') {
            steps {
                bat 'dotnet build DIAS.slnx --configuration Release --no-restore'
            }
        }

        stage('Publish') {
            steps {
                bat 'dotnet publish Web/Web.csproj --configuration Release --output "%WORKSPACE%\\publish" --no-build'
            }
        }
    }

    post {
        success {
            echo 'Build completed successfully.'
        }

        failure {
            echo 'Build failed.'
        }
    }
}